{
  "compilerOptions": {
    "module": "nodenext",
    "outDir":"dist", //diretorio para onde vão os arquivos pos compilação
    "rootDir": "src", //diretorio com arquivos originais
    "target": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
  }
}
